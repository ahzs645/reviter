+/// Advanced, opt-in source metadata/owner-graph extraction. Does not export
+/// geometry or certify rooms. Resource limits and partial/unsupported results
+/// are returned explicitly; large native integers retain exact decimal text.
+#[wasm_bindgen(js_name = openNativeEvidence)]
+pub fn open_native_evidence(bytes: &[u8], options: JsValue) -> Result<JsValue, JsValue> {
+    install_panic_hook();
+    let options = if options.is_null() || options.is_undefined() {
+        native_evidence::NativeEvidenceOptions::default()
+    } else {
+        serde_wasm_bindgen::from_value(options).map_err(err_str)?
+    };
+    let result = native_evidence::extract_native_evidence(bytes, options).map_err(err_str)?;
+    serde::Serialize::serialize(&result, &serde_wasm_bindgen::Serializer::json_compatible())
+        .map_err(err_str)
+}
