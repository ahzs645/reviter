+    rooms: pair,
+    point: door.point,
+    from: points[0],
+    to: points[1],
+    halfWidth: door.halfWidth,
+    halfHeight: door.halfHeight,
+    footprint: door.footprint,
+    normal: door.normal,
+  };
+}
 export function doorCandidates(
