+  if b == 0 { for i in 0..m { x[i] = x[i + w] } } else { for i in 0..m { let hi = if i + w + 1 < n { x[i + w + 1] } else { 0 }; x[i] = (x[i + w] >> b) | (hi << (64 - b)) } }
