{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviter.local/schemas/capability-manifest.schema.json",
  "title": "Reviter executable capability claim ceilings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "release",
    "narrowElementIds",
    "capabilities",
    "caveats"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "release": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "narrowElementIds": {
      "type": "boolean"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "area",
          "implementation",
          "status",
          "eligible",
          "scope",
          "limitations",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "enum": [
              "metadata",
              "semantics",
              "geometry",
              "safety"
            ]
          },
          "implementation": {
            "enum": [
              "reviter",
              "vendored-rvt-rs"
            ]
          },
          "status": {
            "enum": [
              "partial",
              "experimental",
              "unsupported"
            ]
          },
          "eligible": {
            "type": "boolean"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "caveats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
